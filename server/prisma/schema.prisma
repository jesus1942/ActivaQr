generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Plan {
  inicial
  empresa
  industrial
}

enum EstadoEmpresa {
  activa
  suspendida
}

enum RolUsuario {
  superadmin
  admin
  operador
  tecnico
  mantenimiento
  jefatura
  direccion
}

enum EstadoActivo {
  normal
  alerta
  critico
  mantenimiento
}

enum EstadoOperativo {
  operativo
  pausa
  mantenimiento
  montaje
  fuera_servicio
}

enum Vibracion {
  ninguna
  leve
  moderada
  alta
}

enum EstadoMedicion {
  normal
  revision
  urgente
}

enum OrigenMedicion {
  manual
  csv
  api
}

enum EstadoTarea {
  pendiente
  completado
  vencido
}

enum EstadoPermiso {
  pendiente
  activo
  revocado
}

enum TipoParametro {
  numerico
  porcentaje
  booleano
  texto
  seleccion
}

enum NivelAlertaTecnica {
  desmejorado
  riesgo
  critico
}

enum EstadoAlertaTecnica {
  abierta
  propuesta_emitida
  autorizada
  rechazada
  riesgo_aceptado
  cerrada
}

enum EstadoOrdenCorrectiva {
  autorizada
  programada
  en_progreso
  completada
  cancelada
}

enum EstadoPermisoTrabajo {
  no_requerido
  pendiente
  aprobado
  rechazado
  vencido
}

// ---------- Modelos ----------

model PermisoAccesoRemoto {
  id           String        @id @default(uuid())
  empresaId    String        @unique // una empresa, un permiso activo a la vez
  token        String        @unique // token del link de aprobación
  estado       EstadoPermiso @default(pendiente)
  solicitadoEn DateTime      @default(now())
  otorgadoEn   DateTime?
  revocadoEn   DateTime?
  // Costo adicional facturado por este servicio
  costoMensual Float?

  empresa  Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  mensajes MensajeRemoto[]

  @@index([token])
}

model MensajeRemoto {
  id          String   @id @default(uuid())
  permisoId   String
  autorRol    String // 'superadmin' | 'cliente'
  autorNombre String
  contenido   String?
  tipo        String   @default("texto") // 'texto' | 'imagen' | 'audio'
  adjunto     String?  @db.Text // data URL base64 de imagen/audio
  creadoEn    DateTime @default(now())
  leido       Boolean  @default(false)

  // Evidencia forense para mensajes con foto (ver Foto.capturedAt para detalle).
  capturedLat     Float?
  capturedLng     Float?
  capturedAt      DateTime?
  deviceModel     String?
  fuenteUbicacion String?

  permiso PermisoAccesoRemoto @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@index([permisoId])
}

model Empresa {
  id             String        @id @default(uuid())
  nombre         String
  cuit           String?
  logoUrl        String?
  plan           Plan          @default(inicial)
  planSolicitado Plan? // upgrade request from client
  estado         EstadoEmpresa @default(activa)
  creadaEn       DateTime      @default(now())

  // Free trial autogestionado de 30 dias.
  esTrial         Boolean   @default(false)
  trialFin        DateTime? // fin del acceso completo (registro + 30d)
  trialLecturaFin DateTime? // fin del modo solo-lectura (igual a trialFin: sin fase intermedia)

  // Aceptacion de Politicas de Uso y Privacidad.
  // Requisito previo a la generacion del link de suscripcion.
  politicasAceptadasEn DateTime?
  politicasAceptadasIp String?
  politicasVersion     String?

  // Suscripción Mercado Pago.
  mpPreapprovalId           String? // id del preapproval (suscripción) en MP
  mpEstadoSub               String? // estado reportado por MP: authorized, paused, cancelled...
  mpMonto                   Float? // monto mensual acordado
  mpMontoUsd                Float? // precio canónico en USD aplicado al plan y bloques
  mpCotizacionUsdArs        Float? // dólar MEP vendedor usado para calcular mpMonto
  mpCotizacionFuente        String?
  mpCotizacionActualizadaEn DateTime?
  mpUltimoPago              DateTime? // fecha del último pago aprobado
  fuenteAlta                String?
  campanaAlta               String?
  contenidoAlta             String?

  usuarios           Usuario[]
  sedes              Sede[]
  sectores           Sector[]
  tipos              TipoActivo[]
  activos            Activo[]
  permisoAcceso      PermisoAccesoRemoto?
  categorias         CategoriaEquipo[]
  pagos              PagoMP[]
  cotizaciones       Cotizacion[]
  alertasTecnicas    AlertaTecnica[]
  ordenesCorrectivas OrdenTrabajoCorrectiva[]
  moduloControl      ModuloControlEmpresa?
  integracionesIoT   IntegracionIoT[]
  dispositivosIoT    DispositivoIoT[]
  variablesIoT       VariableIoT[]
  reglasAlarmaIoT    ReglaAlarmaIoT[]
  alarmasIoT         AlarmaIoT[]
  comandosIoT        ComandoIoT[]
  escenasIoT         EscenaIoT[]
  integracionesCamara IntegracionCamara[]
  camaras            Camara[]
  eventosCamara      EventoCamara[]

  @@index([mpPreapprovalId])
}

// Propuestas comerciales emitidas por ActivaQR para empresas registradas.
// El detalle conserva la composición del precio aplicada en ese momento.
model Cotizacion {
  id               String    @id @default(uuid())
  numero           String    @unique
  empresaId        String
  clienteNombre    String
  contactoNombre   String?
  contactoEmail    String?
  contactoTelefono String?
  concepto         String
  planSoftware     String
  tipo             String    @default("gestionado") // gestionado | correctivo
  alertaTecnicaId  String?   @unique
  detalle          Json
  moneda           String    @default("ARS")
  subtotal         Float
  descuento        Float     @default(0)
  total            Float
  vigenciaHasta    DateTime
  estado           String    @default("borrador") // borrador | enviada | vista | aceptada | rechazada | vencida
  creadaPorId      String?
  creadaPorNombre  String
  enviadaEn        DateTime?
  vistaEn          DateTime?
  respondidaEn     DateTime?
  creadaEn         DateTime  @default(now())
  actualizadaEn    DateTime  @updatedAt

  empresa         Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  alertaTecnica   AlertaTecnica?          @relation(fields: [alertaTecnicaId], references: [id], onDelete: SetNull)
  ordenCorrectiva OrdenTrabajoCorrectiva?
  envios          CotizacionEnvio[]
  mensajes        CotizacionMensaje[]

  @@index([empresaId, creadaEn])
  @@index([estado, creadaEn])
}

model CotizacionEnvio {
  id           String   @id @default(uuid())
  cotizacionId String
  canal        String // plataforma | email | whatsapp | telegram
  estado       String // enviado | preparado | error
  detalle      String?
  creadoEn     DateTime @default(now())

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId, creadoEn])
}

model CotizacionMensaje {
  id           String   @id @default(uuid())
  cotizacionId String
  autorId      String?
  autorRol     String // superadmin | cliente
  autorNombre  String
  contenido    String   @db.Text
  creadoEn     DateTime @default(now())

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId, creadoEn])
}

// Hallazgo técnico originado en una medición de ActivaQR. Una alerta no
// autoriza trabajo ni costo: la autorización ocurre mediante Cotizacion.
model AlertaTecnica {
  id                  String              @id @default(uuid())
  numero              String              @unique
  empresaId           String
  activoId            String
  medicionId          String?             @unique
  nivel               NivelAlertaTecnica
  estado              EstadoAlertaTecnica @default(abierta)
  hallazgo            String              @db.Text
  riesgo              String              @db.Text
  recomendacion       String              @db.Text
  recomiendaDetencion Boolean             @default(false)
  decisionCliente     String? // detener_aislar | continuar_operando
  decisionDetalle     String?             @db.Text
  decisionPorId       String?
  decisionPorNombre   String?
  decisionEn          DateTime?
  creadaPorId         String?
  creadaPorNombre     String
  creadaEn            DateTime            @default(now())
  actualizadaEn       DateTime            @updatedAt

  empresa    Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  activo     Activo                  @relation(fields: [activoId], references: [id], onDelete: Cascade)
  medicion   Medicion?               @relation(fields: [medicionId], references: [id], onDelete: SetNull)
  cotizacion Cotizacion?
  orden      OrdenTrabajoCorrectiva?

  @@index([empresaId, creadaEn])
  @@index([activoId, estado])
}

// Se crea únicamente cuando el administrador del cliente acepta la
// cotización correctiva. La ejecución puede quedar condicionada a permiso.
model OrdenTrabajoCorrectiva {
  id                       String                @id @default(uuid())
  numero                   String                @unique
  empresaId                String
  activoId                 String
  alertaId                 String                @unique
  cotizacionId             String                @unique
  estado                   EstadoOrdenCorrectiva @default(autorizada)
  alcance                  String                @db.Text
  materialesPrevistos      String?               @db.Text
  plazoEstimadoDias        Int
  costoAprobado            Float
  moneda                   String                @default("ARS")
  requierePermiso          Boolean               @default(false)
  estadoPermiso            EstadoPermisoTrabajo  @default(no_requerido)
  permisoCondiciones       String?               @db.Text
  permisoValidoDesde       DateTime?
  permisoValidoHasta       DateTime?
  permisoAprobadoPorId     String?
  permisoAprobadoPorNombre String?
  permisoAprobadoEn        DateTime?
  autorizadaPorId          String?
  autorizadaPorNombre      String
  autorizadaEn             DateTime              @default(now())
  programadaPara           DateTime?
  responsableNombre        String?
  iniciadaEn               DateTime?
  finalizadaEn             DateTime?
  cierreTrabajo            String?               @db.Text
  repuestosUtilizados      String?               @db.Text
  horasTrabajo             Float?
  evidencias               Json?
  medicionCierreId         String?
  conformidadCliente       String                @default("pendiente") // pendiente | conforme | observada
  conformidadDetalle       String?               @db.Text
  conformidadPorId         String?
  conformidadPorNombre     String?
  conformidadEn            DateTime?
  creadaEn                 DateTime              @default(now())
  actualizadaEn            DateTime              @updatedAt

  empresa        Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  activo         Activo        @relation(fields: [activoId], references: [id], onDelete: Cascade)
  alerta         AlertaTecnica @relation(fields: [alertaId], references: [id], onDelete: Restrict)
  cotizacion     Cotizacion    @relation(fields: [cotizacionId], references: [id], onDelete: Restrict)
  medicionCierre Medicion?     @relation("MedicionCierreCorrectivo", fields: [medicionCierreId], references: [id], onDelete: SetNull)

  @@index([empresaId, estado])
  @@index([activoId, creadaEn])
}

model CotizacionUsdArs {
  id           String   @id
  tipo         String
  compra       Float?
  venta        Float
  fuente       String
  fechaFuente  DateTime
  consultadaEn DateTime @default(now()) @updatedAt
}

model Usuario {
  id               String     @id @default(uuid())
  empresaId        String? // null para el superadmin (no pertenece a una empresa)
  email            String     @unique
  passwordHash     String
  nombre           String
  telefono         String?
  cargo            String?
  rol              RolUsuario @default(admin)
  activo           Boolean    @default(true)
  creadoEn         DateTime   @default(now())
  ultimoAcceso     DateTime?
  resetToken       String?    @unique
  resetTokenExpiry DateTime?
  telegramChatId   String?

  empresa              Empresa?             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pushSubscriptions    PushSubscription[]
  activosResponsable   Activo[]             @relation("ActivoResponsable")
  tareasResponsable    TareaMantenimiento[] @relation("TareaResponsable")
  medicionesRealizadas Medicion[]           @relation("MedicionTecnico")

  @@index([empresaId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  usuarioId String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Sede {
  id        String  @id @default(uuid())
  empresaId String
  nombre    String
  direccion String?
  ciudad    String?

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  activos Activo[]

  @@index([empresaId])
}

model Sector {
  id        String  @id @default(uuid())
  empresaId String
  nombre    String
  color     String?
  activo    Boolean @default(true)

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  activos Activo[]

  @@index([empresaId])
}

model CategoriaEquipo {
  id          String  @id @default(uuid())
  empresaId   String?
  nombre      String
  icono       String?
  descripcion String?
  orden       Int     @default(0)

  empresa    Empresa?             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parametros ParametroCategoria[]
  tipos      TipoActivo[]
  fallas     FallaCatalogo[]

  @@index([empresaId])
}

// Catalogo de fallas tipicas por categoria de equipo.
// Pensado como base de conocimiento accesible desde la ficha publica del QR:
// el tecnico en campo busca el sintoma y ve causas probables + solucion paso a paso.
// Severidad: info | advertencia | critico.
model FallaCatalogo {
  id            String   @id @default(uuid())
  categoriaId   String
  empresaId     String? // null = falla global (provista por ActivaQR), no-null = privada del tenant
  codigo        String? // opcional, p.ej. "E04" o "P0301"
  sintoma       String // texto observable: "Temperatura del refrigerante supera 95°C"
  causas        Json // [{ causa: string, probabilidad: 'alta'|'media'|'baja' }]
  solucion      String // pasos a seguir (markdown simple)
  severidad     String   @default("advertencia") // info | advertencia | critico
  orden         Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  categoria CategoriaEquipo @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([categoriaId])
  @@index([empresaId])
}

model ParametroCategoria {
  id             String        @id @default(uuid())
  categoriaId    String
  nombre         String
  clave          String
  unidad         String?
  tipo           TipoParametro @default(numerico)
  opciones       Json?
  valoresAlerta  Json?
  valoresCritico Json?
  valoresUrgente Json?
  obligatorio    Boolean       @default(false)
  orden          Int           @default(0)
  minNormal      Float?
  maxNormal      Float?
  umbralAlerta   Float?
  umbralCritico  Float?
  umbralUrgente  Float?
  invertido      Boolean       @default(false)

  categoria CategoriaEquipo @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([categoriaId])
}

model TipoActivo {
  id              String  @id @default(uuid())
  empresaId       String
  nombre          String
  icono           String?
  categoriaId     String?
  mideTemperatura Boolean @default(true)
  mideAmperaje    Boolean @default(false)
  midePresion     Boolean @default(false)
  mideVibracion   Boolean @default(true)
  mideBateria     Boolean @default(false)
  mideToner       Boolean @default(false)
  mideContador    Boolean @default(false)
  mideVoltaje     Boolean @default(false)
  mideHoras       Boolean @default(true)
  activo          Boolean @default(true)

  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria CategoriaEquipo? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  activos   Activo[]

  @@index([empresaId])
  @@index([categoriaId])
}

model Activo {
  id                          String          @id @default(uuid())
  empresaId                   String
  sedeId                      String?
  sectorId                    String
  tipoId                      String
  responsableId               String?
  codigo                      String
  nombre                      String
  marca                       String?
  modelo                      String?
  fechaIngreso                DateTime
  ubicacion                   String?
  horasActuales               Int             @default(0)
  kilometrosActuales          Int             @default(0)
  estrategiaMantenimiento     String          @default("fecha")
  intervaloMantenimiento      Int?
  unidadMantenimiento         String?
  proximoMantenimientoLectura Int?
  ultimaFechaMantenimiento    DateTime?
  estado                      EstadoActivo    @default(normal)
  estadoOperativo             EstadoOperativo @default(operativo)
  temperaturaMin              Float?
  temperaturaMax              Float?
  temperaturaAlerta           Float?
  temperaturaCritica          Float?
  amperajeNormal              Float?
  amperajeAlerta              Float?
  amperajeCritico             Float?
  presionNormal               Float?
  presionAlerta               Float?
  presionCritica              Float?
  voltajeMin                  Float?
  voltajeMax                  Float?
  voltajeAlerta               Float?
  bateriaAlerta               Int?
  bateriaCritica              Int?
  tonerAlerta                 Int?
  tonerCritico                Int?
  intervaloMedicionHoras      Int?
  intervaloLubricacionHoras   Int?
  intervaloRodamientoHoras    Int?
  proximoMantenimiento        DateTime?
  notas                       String?
  // Foto principal del activo: data URL JPEG comprimida client-side
  // (max ~640px). Se gestiona SOLO via POST/DELETE /api/activos/:id/foto;
  // el sync masivo no la toca para no inflar el array que viaja en cada save.
  fotoUrl                     String?         @db.Text
  visibilidadPublica          Json?
  esItinerante                Boolean         @default(false)
  locacionBase                String?
  locacionActual              String?
  fechaSalida                 DateTime?
  fechaRetorno                DateTime?
  creadoEn                    DateTime        @default(now())
  actualizadoEn               DateTime        @updatedAt

  empresa     Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sede        Sede?      @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  sector      Sector     @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  tipo        TipoActivo @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  responsable Usuario?   @relation("ActivoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  mediciones         Medicion[]
  tareas             TareaMantenimiento[]
  documentos         Documento[]
  alertasTecnicas    AlertaTecnica[]
  ordenesCorrectivas OrdenTrabajoCorrectiva[]
  dispositivosIoT    DispositivoIoT[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([sectorId])
  @@index([tipoId])
}

// Servicio premium ActivaQR Control. Se licencia por tenant de manera
// independiente del plan base y solo el Superadmin puede habilitarlo.
model ModuloControlEmpresa {
  id                       String   @id @default(uuid())
  empresaId                String   @unique
  estado                   String   @default("configuracion") // configuracion | activo | suspendido
  nombreServicio           String   @default("ActivaQR Control")
  cargoImplementacionUsd   Float?
  abonoMensualUsd          Float?
  monedaFacturacion        String   @default("USD")
  limiteDispositivos       Int      @default(25)
  limiteGateways           Int      @default(2)
  retencionDias            Int      @default(365)
  umbralSinConexionMinutos Int      @default(10)
  controlRemotoHabilitado  Boolean  @default(false)
  tableroConfig            Json?
  notasComerciales         String?  @db.Text
  habilitadoEn             DateTime @default(now())
  habilitadoPorId          String?
  actualizadoEn            DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([estado])
}

// Conector desacoplado del fabricante. Las credenciales se cifran en el
// servidor con IOT_CREDENTIALS_KEY y nunca se exponen al navegador.
model IntegracionIoT {
  id                   String    @id @default(uuid())
  empresaId            String
  nombre               String
  proveedor            String // sonoff_ewelink | milesight_ug65 | webhook_generico
  estado               String    @default("pendiente") // pendiente | configurada | conectada | error | pausada
  credencialesCifradas String?   @db.Text
  configuracion        Json?
  webhookTokenHash     String?   @unique
  webhookTokenHint     String?
  ultimoEventoEn       DateTime?
  ultimoError          String?   @db.Text
  creadaEn             DateTime  @default(now())
  actualizadaEn        DateTime  @updatedAt

  empresa      Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  dispositivos DispositivoIoT[]

  @@index([empresaId, proveedor])
  @@index([empresaId, estado])
}

model DispositivoIoT {
  id                   String    @id @default(uuid())
  empresaId            String
  integracionId        String
  activoId             String?
  identificadorExterno String
  nombre               String
  modelo               String?
  tipo                 String    @default("sensor")
  estado               String    @default("sin_datos") // normal | advertencia | critico | sin_datos | desconectado
  habilitado           Boolean   @default(true)
  permiteControl       Boolean   @default(false)
  ubicacion            String?
  ultimoContactoEn     DateTime?
  bateria              Float?
  rssi                 Float?
  metadatos            Json?
  creadaEn             DateTime  @default(now())
  actualizadaEn        DateTime  @updatedAt

  empresa     Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  integracion IntegracionIoT @relation(fields: [integracionId], references: [id], onDelete: Cascade)
  activo      Activo?        @relation(fields: [activoId], references: [id], onDelete: SetNull)
  variables   VariableIoT[]
  alarmas     AlarmaIoT[]
  comandos    ComandoIoT[]

  @@unique([integracionId, identificadorExterno])
  @@index([empresaId, estado])
  @@index([activoId])
}

model VariableIoT {
  id            String    @id @default(uuid())
  empresaId     String
  dispositivoId String
  clave         String
  nombre        String
  tipo          String    @default("numero") // numero | booleano | texto
  unidad        String?
  valorNumero   Float?
  valorBooleano Boolean?
  valorTexto    String?
  calidad       String    @default("buena")
  medidaEn      DateTime?
  actualizadaEn DateTime  @updatedAt

  empresa     Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  dispositivo DispositivoIoT   @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  lecturas    LecturaIoT[]
  reglas      ReglaAlarmaIoT[]
  alarmas     AlarmaIoT[]

  @@unique([dispositivoId, clave])
  @@index([empresaId, medidaEn])
}

model LecturaIoT {
  id            String   @id @default(uuid())
  variableId    String
  valorNumero   Float?
  valorBooleano Boolean?
  valorTexto    String?
  calidad       String   @default("buena")
  medidaEn      DateTime
  recibidaEn    DateTime @default(now())

  variable VariableIoT @relation(fields: [variableId], references: [id], onDelete: Cascade)

  @@index([variableId, medidaEn])
}

model ReglaAlarmaIoT {
  id             String   @id @default(uuid())
  empresaId      String
  variableId     String
  nombre         String
  operador       String // gt | gte | lt | lte | eq | neq
  umbralNumero   Float?
  umbralBooleano Boolean?
  umbralTexto    String?
  demoraSegundos Int      @default(0)
  severidad      String   @default("advertencia") // informacion | advertencia | critica
  activa         Boolean  @default(true)
  notificarPush  Boolean  @default(true)
  condicionDesde DateTime?
  creadaEn       DateTime @default(now())
  actualizadaEn  DateTime @updatedAt

  empresa  Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  variable VariableIoT @relation(fields: [variableId], references: [id], onDelete: Cascade)
  alarmas  AlarmaIoT[]

  @@index([empresaId, activa])
  @@index([variableId])
}

model AlarmaIoT {
  id                  String    @id @default(uuid())
  empresaId           String
  dispositivoId       String
  variableId          String?
  reglaId             String?
  titulo              String
  detalle             String?   @db.Text
  severidad           String
  estado              String    @default("activa") // activa | reconocida | resuelta
  valorDisparador     String?
  iniciadaEn          DateTime  @default(now())
  reconocidaEn        DateTime?
  reconocidaPorId     String?
  reconocidaPorNombre String?
  resolucion          String?   @db.Text
  resueltaEn          DateTime?

  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  dispositivo DispositivoIoT  @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  variable    VariableIoT?    @relation(fields: [variableId], references: [id], onDelete: SetNull)
  regla       ReglaAlarmaIoT? @relation(fields: [reglaId], references: [id], onDelete: SetNull)

  @@index([empresaId, estado, iniciadaEn])
  @@index([dispositivoId, estado])
}

model ComandoIoT {
  id                  String    @id @default(uuid())
  empresaId           String
  dispositivoId       String
  tipo                String // rele | setpoint | salida | personalizado
  payload             Json
  motivo              String    @db.Text
  estado              String    @default("pendiente") // pendiente | enviado | ejecutado | rechazado | error
  solicitadoPorId     String
  solicitadoPorNombre String
  solicitadoEn        DateTime  @default(now())
  aprobadoPorId       String?
  aprobadoPorNombre   String?
  aprobadoEn          DateTime?
  ejecutadoEn         DateTime?
  resultado           String?   @db.Text

  empresa     Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  dispositivo DispositivoIoT @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  @@index([empresaId, estado, solicitadoEn])
  @@index([dispositivoId, solicitadoEn])
}

model EscenaIoT {
  id                    String    @id @default(uuid())
  empresaId             String
  nombre                String
  descripcion           String?   @db.Text
  activa                Boolean   @default(true)
  acciones              Json
  creadaPorId           String
  creadaPorNombre       String
  ultimaEjecucionEn     DateTime?
  ultimaEjecucionEstado String?
  creadaEn              DateTime  @default(now())
  actualizadaEn         DateTime  @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, activa])
  @@index([empresaId, creadaEn])
}

// Conectores de video desacoplados del fabricante. ActivaQR nunca expone
// credenciales RTSP/ONVIF al navegador: el vivo llega desde un gateway HTTPS.
model IntegracionCamara {
  id                   String   @id @default(uuid())
  empresaId            String
  nombre               String
  proveedor            String // onvif | frigate | hikvision | dahua | reolink | tuya | generico
  estado               String   @default("pendiente") // pendiente | configurada | conectada | error | pausada
  credencialesCifradas String?  @db.Text
  configuracion        Json?
  webhookTokenHash     String?  @unique
  webhookTokenHint     String?
  ultimoEventoEn       DateTime?
  ultimoError          String?  @db.Text
  creadaEn             DateTime @default(now())
  actualizadaEn        DateTime @updatedAt

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  camaras Camara[]

  @@index([empresaId, proveedor])
  @@index([empresaId, estado])
}

model Camara {
  id                    String    @id @default(uuid())
  empresaId             String
  integracionId         String
  identificadorExterno  String
  nombre                String
  ubicacion              String?
  modelo                 String?
  estado                 String    @default("sin_datos") // en_linea | sin_datos | desconectada | error
  habilitada             Boolean   @default(true)
  reproduccionUrl        String?   @db.Text // sólo HTTPS, sin usuario ni contraseña
  protocoloReproduccion  String? // hls | webrtc | jpeg
  capacidades            Json?
  ultimoContactoEn       DateTime?
  ultimoMovimientoEn     DateTime?
  creadaEn               DateTime  @default(now())
  actualizadaEn          DateTime  @updatedAt

  empresa     Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  integracion IntegracionCamara @relation(fields: [integracionId], references: [id], onDelete: Cascade)
  eventos     EventoCamara[]

  @@unique([integracionId, identificadorExterno])
  @@index([empresaId, estado])
  @@index([empresaId, ultimoMovimientoEn])
}

model EventoCamara {
  id            String    @id @default(uuid())
  empresaId     String
  camaraId      String
  identificadorExterno String?
  tipo          String // movimiento | persona | vehiculo | animal | linea | manipulacion | desconexion
  etiqueta      String?
  zona          String?
  confianza     Float?
  iniciadoEn    DateTime
  finalizadoEn  DateTime?
  snapshotUrl   String?   @db.Text
  clipUrl       String?   @db.Text
  metadatos     Json?
  recibidoEn    DateTime  @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  camara  Camara  @relation(fields: [camaraId], references: [id], onDelete: Cascade)

  @@index([empresaId, iniciadoEn])
  @@index([camaraId, iniciadoEn])
  @@index([empresaId, tipo, iniciadoEn])
  @@unique([camaraId, identificadorExterno])
}

model Medicion {
  id                String         @id @default(uuid())
  activoId          String
  tecnicoId         String?
  fecha             DateTime       @default(now())
  temperatura       Float?
  amperaje          Float?
  presion           Float?
  vibracion         Vibracion      @default(ninguna)
  horasMarcha       Int?
  kilometraje       Int?
  voltaje           Float?
  porcentajeBateria Int?
  nivelToner        Int?
  contador          Int?
  estado            EstadoMedicion @default(normal)
  observaciones     String?
  origen            OrigenMedicion @default(manual)
  parametrosExtra   Json?

  activo             Activo                   @relation(fields: [activoId], references: [id], onDelete: Cascade)
  tecnico            Usuario?                 @relation("MedicionTecnico", fields: [tecnicoId], references: [id], onDelete: SetNull)
  fotos              Foto[]
  alertaTecnica      AlertaTecnica?
  cierresCorrectivos OrdenTrabajoCorrectiva[] @relation("MedicionCierreCorrectivo")

  @@index([activoId])
}

model Foto {
  id         String @id @default(uuid())
  medicionId String
  url        String

  // Cadena de custodia digital / evidencia forense de la foto.
  // Cuando el celular saca la foto, la imagen trae metadatos EXIF: GPS, fecha
  // y modelo de dispositivo. Eso se extrae al subirla y se guarda aca para
  // probar despues 'donde y cuando se hizo realmente la medicion'.
  capturedLat     Float?
  capturedLng     Float?
  capturedAt      DateTime? // timestamp REAL del EXIF, no el del upload
  deviceModel     String? // ej: 'iPhone 13', 'Samsung SM-A536E'
  fuenteUbicacion String? // 'exif' (mas confiable) | 'browser' | null
  subidoEn        DateTime  @default(now())

  medicion Medicion @relation(fields: [medicionId], references: [id], onDelete: Cascade)

  @@index([medicionId])
}

model Visita {
  id        String   @id @default(uuid())
  tipo      String // 'landing' | 'ficha'
  activoId  String? // solo para tipo 'ficha'
  referer   String?
  userAgent String?  @db.Text
  pais      String?
  ciudad    String?
  ip        String?
  seccion   String? // solo para tipo 'seccion': nombre de la pantalla
  empresaId String? // empresa del usuario logueado (tracking interno)
  creadoEn  DateTime @default(now())

  @@index([tipo])
  @@index([activoId])
  @@index([creadoEn])
}

model TareaMantenimiento {
  id              String      @id @default(uuid())
  activoId        String
  responsableId   String?
  numero          Int?
  tipo            String
  prioridad       String      @default("media")
  fechaProgramada DateTime
  fechaRealizada  DateTime?
  estado          EstadoTarea @default(pendiente)
  observaciones   String?
  materiales      String?     @db.Text
  horasTrabajo    Float?
  cerradaPor      String?
  fotos           Json?

  activo      Activo   @relation(fields: [activoId], references: [id], onDelete: Cascade)
  responsable Usuario? @relation("TareaResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([activoId])
}

model RegistroAuditoria {
  id            String   @id @default(uuid())
  empresaId     String?
  usuarioId     String?
  usuarioNombre String
  usuarioRol    String?
  accion        String
  entidad       String
  entidadId     String?
  detalle       String?  @db.Text
  creadoEn      DateTime @default(now())

  @@index([empresaId])
  @@index([entidad])
  @@index([creadoEn])
}

model Documento {
  id       String   @id @default(uuid())
  activoId String
  nombre   String
  tipo     String   @default("otro")
  url      String   @db.Text
  creadoEn DateTime @default(now())

  activo Activo @relation(fields: [activoId], references: [id], onDelete: Cascade)

  @@index([activoId])
}

model PagoMP {
  id            String   @id @default(uuid())
  empresaId     String
  mpPagoId      String?  @unique // ID del pago en MP (para no duplicar)
  monto         Float
  moneda        String   @default("ARS")
  estado        String // approved, pending, rejected, cancelled
  concepto      String?
  fecha         DateTime @default(now())
  preapprovalId String? // ID de la suscripción
  creadoEn      DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([fecha])
}

// Testimonios publicos de la landing. Cualquiera puede enviar uno
// (sin login); queda pendiente hasta que el superadmin lo aprueba.
// Solo los aprobados son visibles al publico. NO confundir con clientes
// pagos: aca puede comentar gente que vio el proyecto, lo apoya, da
// experiencia del rubro, etc.
model Testimonio {
  id         String    @id @default(uuid())
  nombre     String
  rol        String?
  email      String?
  mensaje    String    @db.Text
  estado     String    @default("pendiente") // pendiente | aprobado | rechazado
  destacado  Boolean   @default(false)
  ip         String?
  userAgent  String?   @db.Text
  aprobadoEn DateTime?
  creadoEn   DateTime  @default(now())

  @@index([estado, creadoEn])
}

model Lead {
  id       String   @id @default(uuid())
  nombre   String
  empresa  String?
  email    String
  telefono String?
  mensaje  String?  @db.Text
  plan     String?
  source   String?
  medium   String?
  campaign String?
  content  String?
  term     String?
  creadoEn DateTime @default(now())

  @@index([creadoEn])
  @@index([source, campaign])
}
