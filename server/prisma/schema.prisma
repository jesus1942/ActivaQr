generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Plan {
  inicial
  empresa
  industrial
}

enum EstadoEmpresa {
  activa
  suspendida
}

enum RolUsuario {
  superadmin
  admin
  operador
}

enum RolTecnico {
  admin
  supervisor
  tecnico
}

enum EstadoActivo {
  normal
  alerta
  critico
  mantenimiento
}

enum EstadoOperativo {
  operativo
  pausa
  mantenimiento
  montaje
  fuera_servicio
}

enum Vibracion {
  ninguna
  leve
  moderada
  alta
}

enum EstadoMedicion {
  normal
  revision
  urgente
}

enum OrigenMedicion {
  manual
  csv
  api
}

enum EstadoTarea {
  pendiente
  completado
  vencido
}

enum EstadoPermiso {
  pendiente
  activo
  revocado
}

enum TipoParametro {
  numerico
  porcentaje
  booleano
  texto
  seleccion
}

// ---------- Modelos ----------

model PermisoAccesoRemoto {
  id           String        @id @default(uuid())
  empresaId    String        @unique   // una empresa, un permiso activo a la vez
  token        String        @unique   // token del link de aprobación
  estado       EstadoPermiso @default(pendiente)
  solicitadoEn DateTime      @default(now())
  otorgadoEn   DateTime?
  revocadoEn   DateTime?
  // Costo adicional facturado por este servicio
  costoMensual Float?

  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  mensajes  MensajeRemoto[]

  @@index([token])
}

model MensajeRemoto {
  id        String   @id @default(uuid())
  permisoId String
  autorRol  String   // 'superadmin' | 'cliente'
  autorNombre String
  contenido String?
  tipo      String   @default("texto") // 'texto' | 'imagen' | 'audio'
  adjunto   String?  @db.Text          // data URL base64 de imagen/audio
  creadoEn  DateTime @default(now())
  leido     Boolean  @default(false)

  permiso PermisoAccesoRemoto @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@index([permisoId])
}

model Empresa {
  id        String        @id @default(uuid())
  nombre    String
  cuit      String?
  logoUrl   String?
  plan           Plan          @default(inicial)
  planSolicitado Plan?         // upgrade request from client
  estado    EstadoEmpresa @default(activa)
  creadaEn  DateTime      @default(now())

  // Free trial autogestionado.
  esTrial         Boolean   @default(false)
  trialFin        DateTime? // fin del acceso completo (registro + 14d)
  trialLecturaFin DateTime? // fin del modo solo-lectura (registro + 28d)

  // Suscripción Mercado Pago.
  mpPreapprovalId String?   // id del preapproval (suscripción) en MP
  mpEstadoSub     String?   // estado reportado por MP: authorized, paused, cancelled...
  mpMonto         Float?    // monto mensual acordado
  mpUltimoPago    DateTime? // fecha del último pago aprobado

  usuarios       Usuario[]
  sedes          Sede[]
  sectores       Sector[]
  tipos          TipoActivo[]
  tecnicos       Tecnico[]
  activos        Activo[]
  permisoAcceso  PermisoAccesoRemoto?
  categorias     CategoriaEquipo[]

  @@index([mpPreapprovalId])
}

model Usuario {
  id           String     @id @default(uuid())
  empresaId    String?    // null para el superadmin (no pertenece a una empresa)
  email        String     @unique
  passwordHash String
  nombre       String
  telefono     String?
  rol          RolUsuario @default(admin)
  activo           Boolean    @default(true)
  creadoEn         DateTime   @default(now())
  ultimoAcceso     DateTime?
  resetToken       String?    @unique
  resetTokenExpiry DateTime?

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@index([empresaId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  usuarioId String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId])
}

model Sede {
  id        String  @id @default(uuid())
  empresaId String
  nombre    String
  direccion String?
  ciudad    String?

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  activos Activo[]

  @@index([empresaId])
}

model Sector {
  id        String  @id @default(uuid())
  empresaId String
  nombre    String
  color     String?
  activo    Boolean @default(true)

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  activos Activo[]

  @@index([empresaId])
}

model CategoriaEquipo {
  id          String  @id @default(uuid())
  empresaId   String?
  nombre      String
  icono       String?
  descripcion String?
  orden       Int     @default(0)

  empresa    Empresa?             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parametros ParametroCategoria[]
  tipos      TipoActivo[]

  @@index([empresaId])
}

model ParametroCategoria {
  id            String        @id @default(uuid())
  categoriaId   String
  nombre        String
  clave         String
  unidad        String?
  tipo          TipoParametro @default(numerico)
  obligatorio   Boolean       @default(false)
  orden         Int           @default(0)
  minNormal     Float?
  maxNormal     Float?
  umbralAlerta  Float?
  umbralCritico Float?
  umbralUrgente Float?
  invertido     Boolean       @default(false)

  categoria CategoriaEquipo @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([categoriaId])
}

model TipoActivo {
  id               String  @id @default(uuid())
  empresaId        String
  nombre           String
  icono            String?
  categoriaId      String?
  mideTemperatura  Boolean @default(true)
  mideAmperaje     Boolean @default(false)
  midePresion      Boolean @default(false)
  mideVibracion    Boolean @default(true)
  mideBateria      Boolean @default(false)
  mideToner        Boolean @default(false)
  mideContador     Boolean @default(false)
  mideVoltaje      Boolean @default(false)
  activo           Boolean @default(true)

  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria CategoriaEquipo? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  activos   Activo[]

  @@index([empresaId])
  @@index([categoriaId])
}

model Tecnico {
  id        String     @id @default(uuid())
  empresaId String
  nombre    String
  rol       RolTecnico @default(tecnico)
  email     String?
  telefono  String?
  activo    Boolean    @default(true)

  empresa            Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  activos            Activo[]
  mediciones         Medicion[]
  tareas             TareaMantenimiento[]

  @@index([empresaId])
}

model Activo {
  id                        String       @id @default(uuid())
  empresaId                 String
  sedeId                    String?
  sectorId                  String
  tipoId                    String
  responsableId             String?
  codigo                    String
  nombre                    String
  marca                     String?
  modelo                    String?
  fechaIngreso              DateTime
  ubicacion                 String?
  horasActuales             Int          @default(0)
  estado                    EstadoActivo @default(normal)
  estadoOperativo           EstadoOperativo @default(operativo)
  temperaturaMin            Float?
  temperaturaMax            Float?
  temperaturaAlerta         Float?
  temperaturaCritica        Float?
  amperajeNormal            Float?
  amperajeAlerta            Float?
  amperajeCritico           Float?
  presionNormal             Float?
  presionAlerta             Float?
  presionCritica            Float?
  voltajeMin                Float?
  voltajeMax                Float?
  voltajeAlerta             Float?
  bateriaAlerta             Int?
  bateriaCritica            Int?
  tonerAlerta               Int?
  tonerCritico              Int?
  intervaloMedicionHoras    Int?
  intervaloLubricacionHoras Int?
  intervaloRodamientoHoras  Int?
  proximoMantenimiento      DateTime?
  notas                     String?
  visibilidadPublica        Json?
  esItinerante              Boolean      @default(false)
  locacionBase              String?
  locacionActual            String?
  fechaSalida               DateTime?
  fechaRetorno              DateTime?
  creadoEn                  DateTime     @default(now())
  actualizadoEn             DateTime     @updatedAt

  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sede        Sede?    @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  sector      Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  tipo        TipoActivo @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  responsable Tecnico? @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  mediciones Medicion[]
  tareas     TareaMantenimiento[]
  documentos Documento[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([sectorId])
  @@index([tipoId])
}

model Medicion {
  id            String         @id @default(uuid())
  activoId      String
  tecnicoId     String?
  fecha         DateTime       @default(now())
  temperatura   Float?
  amperaje      Float?
  presion       Float?
  vibracion     Vibracion      @default(ninguna)
  horasMarcha       Int?
  voltaje           Float?
  porcentajeBateria Int?
  nivelToner        Int?
  contador          Int?
  estado          EstadoMedicion @default(normal)
  observaciones   String?
  origen          OrigenMedicion @default(manual)
  parametrosExtra Json?

  activo  Activo   @relation(fields: [activoId], references: [id], onDelete: Cascade)
  tecnico Tecnico? @relation(fields: [tecnicoId], references: [id], onDelete: SetNull)
  fotos   Foto[]

  @@index([activoId])
}

model Foto {
  id         String @id @default(uuid())
  medicionId String
  url        String

  medicion Medicion @relation(fields: [medicionId], references: [id], onDelete: Cascade)

  @@index([medicionId])
}

model Visita {
  id        String   @id @default(uuid())
  tipo      String   // 'landing' | 'ficha'
  activoId  String?  // solo para tipo 'ficha'
  referer   String?
  userAgent String?  @db.Text
  pais      String?
  ciudad    String?
  ip        String?
  seccion   String?  // solo para tipo 'seccion': nombre de la pantalla
  empresaId String?  // empresa del usuario logueado (tracking interno)
  creadoEn  DateTime @default(now())

  @@index([tipo])
  @@index([activoId])
  @@index([creadoEn])
}

model TareaMantenimiento {
  id              String      @id @default(uuid())
  activoId        String
  responsableId   String?
  numero          Int?
  tipo            String
  prioridad       String      @default("media")
  fechaProgramada DateTime
  fechaRealizada  DateTime?
  estado          EstadoTarea @default(pendiente)
  observaciones   String?
  materiales      String?     @db.Text
  horasTrabajo    Float?
  cerradaPor      String?
  fotos           Json?

  activo      Activo   @relation(fields: [activoId], references: [id], onDelete: Cascade)
  responsable Tecnico? @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([activoId])
}

model RegistroAuditoria {
  id            String   @id @default(uuid())
  empresaId     String?
  usuarioId     String?
  usuarioNombre String
  usuarioRol    String?
  accion        String
  entidad       String
  entidadId     String?
  detalle       String?  @db.Text
  creadoEn      DateTime @default(now())

  @@index([empresaId])
  @@index([entidad])
  @@index([creadoEn])
}

model Documento {
  id       String   @id @default(uuid())
  activoId String
  nombre   String
  tipo     String   @default("otro")
  url      String   @db.Text
  creadoEn DateTime @default(now())

  activo Activo @relation(fields: [activoId], references: [id], onDelete: Cascade)

  @@index([activoId])
}
