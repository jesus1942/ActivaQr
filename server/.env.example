DATABASE_URL="postgresql://user:password@localhost:5432/activaqr"
NODE_ENV="development"
PORT=3001

# Seguridad y usuario propietario
JWT_SECRET=""
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NOMBRE="Administrador ActivaQR"

# URLs públicas
SITE_PUBLIC_URL="https://activaqr.net"
APP_PUBLIC_URL="https://activaqr.net/app/"
ALLOWED_ORIGINS="https://activaqr.net,https://www.activaqr.net"

# Mercado Pago (suscripciones)
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_BACK_URL="https://activaqr.net/app/"
# Los planes se expresan en USD dentro del catálogo. El backend consulta el
# dólar MEP vendedor y actualiza automáticamente los importes de Mercado Pago.

# Email transaccional via Resend (resend.com)
# Sin esto el sistema funciona pero no envía emails.
RESEND_API_KEY=""
# Para produccion usar tu dominio verificado. Para pruebas: onboarding@resend.dev
RESEND_FROM="ActivaQR <avisos@activaqr.net>"
# Destino privado para consultas de la landing. Nunca se expone en el frontend.
LEAD_EMAIL="tu-correo-privado@ejemplo.com"

# Avisos opcionales
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:avisos@activaqr.net"
